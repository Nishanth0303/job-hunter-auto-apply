# Server Configuration
PORT=3000
NODE_ENV=production

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
ADMIN_API_KEY=replace_with_secure_admin_api_key_for_cron_and_scans
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://nishanth0303.github.io,http://localhost:3000,http://127.0.0.1:3000

# Storage Paths (relative to Version_3 root or absolute)
DATA_DIR=../data
BACKUP_DIR=../backups
CONFIG_DIR=../config

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PUBLIC_RATE_LIMIT_MAX=30

# External Cloud Backup (Optional)
S3_BACKUP_ENABLED=false
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
